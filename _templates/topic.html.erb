<%# encoding: utf-8 %>
<%
  page_title    = "#{topic_label} — #{SITE_TITLE}"
  description   = "Posts about #{topic_label}."
  canonical_url = "#{SITE_URL}/topics/#{topic_id}.html"
  og_type       = 'website'
  og_title      = nil; og_image = nil; date_iso = nil
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root) %>
<%= renderer.breadcrumb_ld([[SITE_TITLE, SITE_URL], ['Writing', "#{SITE_URL}/blog.html"], [topic_label, nil]]) %>
</head>
<body>
<%= renderer.partial('header', root: root, current: 'writing') %>
  <div class="page-body">
    <main id="main-content">
      <header class="page-hero container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="<%= root %>blog.html">Writing</a>
          <span class="breadcrumb__sep" aria-hidden="true">&#x203A;</span>
          <span class="breadcrumb__current"><%= h(topic_label) %></span>
        </nav>
        <h1 class="page-hero__title"><%= h(topic_label) %></h1>
        <p class="page-hero__meta"><%= posts.length %> posts</p>
      </header>

      <ol class="blog-list" reversed aria-label="Posts in <%= h(topic_label) %>">
<%- posts.each do |post| -%>
        <%= renderer.partial('post_card', post: post, root: root) %>
<%- end -%>
      </ol>
    </main>
<%= renderer.partial('footer', root: root, current: 'writing') %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
</body>
</html>
