<%# encoding: utf-8 %>
<%
  page_title    = "Journeys — #{SITE_TITLE}"
  description   = "Longer-form photo essays from places and trips — updated as they happen, not dated dispatches."
  canonical_url = "#{SITE_URL}/journeys.html"
  og_type       = 'website'
  og_title      = nil
  og_image      = journeys.find(&:image_url)&.image_url
  date_iso      = nil
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root) %>
</head>
<body>
<%= renderer.partial('header', root: root, current: 'journeys') %>
  <div class="page-body">
    <main id="main-content">
      <header class="page-hero container">
        <h1 class="page-hero__title">Journeys</h1>
        <p class="page-hero__lede"><%= h(description) %></p>
      </header>

      <ol class="blog-list" aria-label="Journeys">
<%- journeys.each do |journey| -%>
        <%= renderer.partial('journey_card', journey: journey, root: root) %>
<%- end -%>
      </ol>
    </main>
<%= renderer.partial('footer', root: root, current: 'journeys') %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
</body>
</html>
