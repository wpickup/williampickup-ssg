<%# encoding: utf-8 %>
<%
  page_title    = "#{photo.title} — #{SITE_TITLE}"
  description   = photo.caption
  canonical_url = photo.url
  og_type       = 'website'
  og_title      = photo.title
  og_image      = photo.image_url
  date_iso      = photo.date_iso
  is_publit     = photo.image_url.to_s.include?('publit.io')
  img           = is_publit ? publit_srcset(photo.image_url, photo.focal_point) : nil
  back_series   = photo.series ? photo.series : nil
  back_label    = back_series == 'highlights' ? 'highlights' : 'Gallery'
  back_url      = back_series == 'highlights' ? "#{root}gallery/highlights.html" : "#{root}gallery.html"
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root) %>
</head>
<body>
<%= renderer.partial('header', root: root) %>
  <div class="page-body">
    <main id="main-content">

      <article class="gallery-image-page container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="<%= root %>gallery.html">Portfolio</a>
<%- if back_series == 'highlights' -%>
          <span class="breadcrumb__sep" aria-hidden="true">&#x203A;</span>
          <a href="<%= root %>gallery/highlights.html">highlights</a>
<%- end -%>
          <span class="breadcrumb__sep" aria-hidden="true">&#x203A;</span>
          <span class="breadcrumb__current"><%= h(photo.title) %></span>
        </nav>

        <figure class="gallery-image-page__figure">
<%- if img -%>
          <img
            src="<%= img[:src] %>"
            srcset="<%= img[:srcset] %>"
            sizes="(max-width: 860px) 100vw, 860px"
            alt="<%= h(photo.image_alt.to_s) %>"
            loading="eager"
            fetchpriority="high"<%= img[:style] %>>
<%- elsif photo.image_url -%>
          <img src="<%= photo.image_url %>" alt="<%= h(photo.image_alt.to_s) %>" loading="eager" fetchpriority="high">
<%- end -%>
<%- if photo.image_alt -%>
          <figcaption><%= h(photo.image_alt) %></figcaption>
<%- end -%>
        </figure>

        <div class="gallery-image-page__info">
          <h1 class="gallery-image-page__title"><%= h(photo.title) %></h1>

          <dl class="gallery-image-page__exif">
<%- if photo.date -%>
            <div class="exif-row">
              <dt>Date</dt>
              <dd><time datetime="<%= photo.date_iso %>"><%= photo.date.strftime('%-d %B %Y') %></time></dd>
            </div>
<%- end -%>
<%- if photo.location -%>
            <div class="exif-row">
              <dt>Location</dt>
              <dd><%= h(photo.location) %></dd>
            </div>
<%- end -%>
<%- if photo.camera -%>
            <div class="exif-row">
              <dt>Camera</dt>
              <dd><%= h(photo.camera) %></dd>
            </div>
<%- end -%>
          </dl>

<%- unless photo.content_html.empty? -%>
          <div class="gallery-image-page__text">
            <%= photo.content_html %>
          </div>
<%- end -%>

          <a href="<%= back_url %>" class="gallery-image-page__back">&#x2190; <%= h(back_label) %></a>
        </div>

      </article>

    </main>
<%= renderer.partial('footer', root: root) %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
</body>
</html>
