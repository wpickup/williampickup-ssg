<%# encoding: utf-8 %>
<%
  page_title    = "#{book.title} — #{SITE_TITLE}"
  description   = "#{book.title} by #{book.author}"
  canonical_url = book.url
  og_type       = 'website'
  og_title      = book.title
  og_image      = book.cover_src
  date_iso      = nil
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root) %>
</head>
<body>
<%= renderer.partial('header', root: root, current: 'reading') %>
  <div class="page-body">
    <main id="main-content">

      <div class="book-page container">
        <article class="book-entry-page">

          <div class="book-entry-page__header">
            <div class="book-entry-page__cover">
<%- if book.cover_src -%>
              <img
                src="<%= book.cover_src %>"
<%- if book.cover_srcset -%>
                srcset="<%= book.cover_srcset %>"
                sizes="(max-width: 560px) 7rem, 180px"
<%- end -%>
                alt="Cover of <%= h(book.title) %>"
                class="book-cover"
                loading="eager">
<%- end -%>
            </div>
            <div class="book-entry-page__meta">
              <h1 class="book-entry-page__title"><%= h(book.title) %></h1>
              <p class="book-entry-page__author"><%= h(book.author.to_s) %></p>
<%- if book.isbn -%>
              <p class="book-entry-page__isbn">ISBN <%= h(book.isbn) %></p>
<%- end -%>
            </div>
          </div>

<%- unless book.content_html.empty? -%>
          <div class="book-entry-page__note">
            <%= book.content_html %>
          </div>
<%- end -%>

          <footer class="book-entry-page__footer">
            <div class="book-find-links">
              <span class="book-find-links__label">Find this book</span>
<%- if book.isbn -%>
              <a href="https://www.booktopia.com.au/search.ep?keywords=<%= CGI.escape(book.title.to_s) %>" class="book-find-link" target="_blank" rel="noopener">Booktopia</a>
              <a href="https://www.worldcat.org/isbn/<%= h(book.isbn) %>" class="book-find-link" target="_blank" rel="noopener">WorldCat library search</a>
<%- end -%>
            </div>
            <a href="<%= root %>reading.html" class="book-back">&#x2190; Reading history</a>
          </footer>

        </article>
      </div>

    </main>
<%= renderer.partial('footer', root: root, current: 'reading') %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
</body>
</html>
