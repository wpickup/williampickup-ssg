<%# encoding: utf-8 %>
<%
  page_title    = SITE_TITLE
  description   = SITE_DESC
  canonical_url = "#{SITE_URL}/"
  og_type       = 'website'
  og_title      = nil; og_image = nil; date_iso = nil
  sections      = now_data['sections'] || {}
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root) %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "<%= h(SITE_TITLE) %>",
        "url": "<%= SITE_URL %>/",
        "description": "<%= h(SITE_DESC) %>",
        "author": { "@id": "<%= SITE_URL %>/bio.html#person" }
      },
      {
        "@type": "Person",
        "@id": "<%= SITE_URL %>/bio.html#person",
        "name": "<%= h(AUTHOR_NAME) %>",
        "url": "<%= SITE_URL %>/bio.html",
        "email": "mailto:<%= AUTHOR_EMAIL %>",
        "sameAs": ["https://github.com/wpickup"]
      }
    ]
  }
  </script>
</head>
<body class="page-home">
<%= renderer.partial('header', root: root) %>
  <div class="page-body">
    <main id="main-content">

      <header class="home-masthead container">
        <div class="home-masthead__name">
          <h1>William<br><em>Pickup</em></h1>
        </div>
        <div class="home-masthead__intro">
          <p><%= SITE_DESC %></p>
          <br/>
          <p class="location-ticker" id="location-ticker" hidden aria-live="polite"></p>
          <p class="listening-to" id="listening-to" data-user="<%= LISTENBRAINZ_USER %>" hidden aria-live="polite"></p>
        </div>
      </header>

<%- if hero_photo -%>
      <section class="home-hero">
        <figure class="gallery-item gallery-item--wide">
          <a href="<%= root %>photos/<%= hero_photo.slug %>.html" class="image-wrap">
            <img src="<%= hero_photo.image_url %>" alt="<%= h(hero_photo.image_alt.to_s) %>" loading="lazy">
          </a>
<%- if hero_photo.caption -%>
          <figcaption><%= h(hero_photo.caption) %></figcaption>
<%- end -%>
        </figure>
      </section>
<%- end -%>

      <div class="container sidebar-layout">

        <div class="sidebar-layout__main">
          <section class="home-posts" aria-label="Recent writing">
            <div class="home-posts__header">
              <span class="home-posts__label">Recent writing</span>
              <a href="<%= root %>blog.html" class="home-posts__all">All writing</a>
            </div>
            <ul class="home-posts__grid h-feed">
<%- posts.each do |post| -%>
              <%= renderer.partial('post_card', post: post, root: root) %>
<%- end -%>
            </ul>
          </section>
        </div>

        <aside class="sidebar-layout__sidebar" aria-label="About, now, and start here">

<%- if bio_page -%>
          <div class="sidebar-card sidebar-bio">
            <a href="<%= root %>bio.html" class="sidebar-bio__photo">
              <img src="<%= root %>assets/WP-at-Stromlo.webp" alt="William Pickup">
            </a>
            <div>
              <p class="sidebar-bio__name">William Pickup</p>
<%- if bio_page.sidebar_blurb -%>
              <p class="sidebar-bio__text"><%= h(bio_page.sidebar_blurb) %></p>
<%- end -%>
              <a href="<%= root %>bio.html" class="sidebar-bio__link">More about me &rarr;</a>
            </div>
          </div>
<%- end -%>

          <div class="sidebar-card sidebar-now">
            <a href="<%= root %>now.html" class="sidebar-card__label">Now</a>
            <dl>
<%- if sections['making'] -%>
              <div class="now-strip__item">
                <dt>Making</dt>
                <dd><%= h(sections['making']) %></dd>
              </div>
<%- end -%>
<%- unless now_books.empty? -%>
              <div class="now-strip__item">
                <dt>Reading</dt>
                <dd class="book-links"><%= now_books.map { |b| %(<a href="#{root}reading/#{b.slug}.html">#{h(b.title)}</a>) }.join('') %></dd>
              </div>
<%- end -%>
<%- if sections['travelling'] -%>
              <div class="now-strip__item">
                <dt>Travelling</dt>
                <dd><%= h(sections['travelling']) %></dd>
              </div>
<%- end -%>
            </dl>
          </div>

          <div class="sidebar-card sidebar-start">
            <span class="sidebar-card__label">Start here</span>
            <ul>
<%- featured_posts.each do |post| -%>
              <li><a href="<%= root %><%= post.url_path %>"><%= h(post.title) %></a><%- if post.description -%> &mdash; <span><%= h(post.description) %></span><%- end -%></li>
<%- end -%>
            </ul>
          </div>

          <div class="sidebar-card sidebar-visual">
            <span class="sidebar-card__label">Visual work</span>
            <ul>
              <li><a href="<%= root %>gallery/highlights.html">Gallery highlights</a> &mdash; selected photographs and observations.</li>
              <li><a href="<%= root %>gallery.html">Portfolio</a> &mdash; visual work, projects, and the more image-led side of the site.</li>
            </ul>
          </div>

<%- unless sidebar_blogroll.empty? -%>
          <div class="sidebar-card sidebar-blogroll">
            <span class="sidebar-card__label">Blogroll</span>
            <ul>
<%- sidebar_blogroll.each do |entry| -%>
              <li><a href="<%= h(entry['url'].to_s) %>" target="_blank" rel="noopener"><%= h(entry['name'].to_s) %></a><%- if entry['desc'] -%> &mdash; <span><%= h(entry['desc']) %></span><%- end -%></li>
<%- end -%>
            </ul>
            <p class="sidebar-card__more"><a href="<%= root %>blogroll.html">Full blogroll &rarr;</a></p>
          </div>
<%- end -%>

<%- unless recent_notes.empty? -%>
          <div class="sidebar-card sidebar-notes">
            <span class="sidebar-card__label">Notes</span>
            <ul>
<%- recent_notes.each do |note| -%>
              <li>
                <a href="<%= root %><%= note.url_path %>"><%= note.title ? h(note.title) : note.date_display %></a>
<%- stripped = note.content_html.gsub(/<[^>]+>/, '').strip -%>
<%- excerpt = stripped.length > 80 ? stripped[0, 80].gsub(/\s\S+$/, '') + '…' : stripped -%>
                &mdash; <span><%= h(excerpt) %></span>
              </li>
<%- end -%>
            </ul>
            <p class="sidebar-card__more"><a href="<%= root %>notes.html">All notes &rarr;</a></p>
          </div>
<%- end -%>

        </aside>

      </div>

    </main>
<%= renderer.partial('footer', root: root) %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
  <script data-goatcounter="https://stats.williampickup.org/count" async src="https://stats.williampickup.org/count.js"></script>
</body>
</html>
