<%# encoding: utf-8 %>
<%
  page_title    = "Blogroll — #{SITE_TITLE}"
  description   = page.description
  canonical_url = "#{SITE_URL}/blogroll.html"
  og_type       = 'website'
  og_title      = nil; og_image = nil; date_iso = nil
  entries       = blogroll_data['entries'] || []
  filters       = blogroll_data['filters'] || []
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head',
      page_title: page_title, description: description,
      canonical_url: canonical_url, og_type: og_type, og_title: og_title,
      og_image: og_image, date_iso: date_iso, root: root,
      extra_css: ['blogroll.css']) %>
</head>
<body>
<%= renderer.partial('header', root: root, current: 'blogroll') %>
  <div class="page-body">
    <main id="main-content">

      <header class="page-hero container">
        <p class="page-hero__eyebrow">Reading list</p>
        <h1 class="page-hero__title">Blogroll</h1>
        <p class="page-hero__lede"><%= h(page.description.to_s) %></p>
      </header>

      <nav class="blogroll-filters container" aria-label="Filter by category">
        <button class="filter-btn active" data-filter="all">All</button>
<%- filters.each do |cat| -%>
        <button class="filter-btn" data-filter="<%= h(cat) %>"><%= h(cat.capitalize) %></button>
<%- end -%>
      </nav>

      <ul class="blogroll-grid container" id="blogroll">
<%- entries.each do |entry| -%>
        <li class="blogroll-item" data-category="<%= h(entry['category'].to_s) %>" data-feed="<%= h(entry['feed'].to_s) %>">
          <span class="blogroll-item__cat"><%= h(entry['category'].to_s) %></span>
          <a class="blogroll-item__name" href="<%= h(entry['url'].to_s) %>" target="_blank" rel="noopener"><%= h(entry['name'].to_s) %></a>
<%- if entry['desc'] -%>
          <p class="blogroll-item__desc"><%= h(entry['desc']) %></p>
<%- else -%>
          <p class="blogroll-item__desc"></p>
<%- end -%>
        </li>
<%- end -%>
      </ul>

    </main>
<%= renderer.partial('footer', root: root, current: 'blogroll') %>
  </div>
  <script defer src="<%= root %>javascript/main.js"></script>
  <script defer src="<%= root %>javascript/blogroll.js"></script>
</body>
</html>
