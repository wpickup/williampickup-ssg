<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title><%= AUTHOR_NAME %></title>
  <link href="<%= SITE_URL %>/" />
  <link rel="self" href="<%= SITE_URL %>/feeds/atom.xml" />
  <id><%= SITE_URL %>/</id>
  <updated><%= Time.now.strftime('%Y-%m-%dT%H:%M:%SZ') %></updated>
  <author>
    <name><%= AUTHOR_NAME %></name>
    <email><%= AUTHOR_EMAIL %></email>
  </author>
<%- posts.each do |entry| -%>
  <entry>
    <title><%= h(entry.title || 'Note') %></title>
    <link href="<%= entry.url %>" />
    <id><%= entry.url %></id>
    <published><%= entry.date_iso %>T00:00:00Z</published>
    <updated><%= entry.date_iso %>T00:00:00Z</updated>
<%- if entry.respond_to?(:description) && entry.description -%>
    <summary><%= h(entry.description) %></summary>
<%- end -%>
    <content type="html"><![CDATA[<%= entry.content_html %>]]></content>
  </entry>
<%- end -%>
</feed>
