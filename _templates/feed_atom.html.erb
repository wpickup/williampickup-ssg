<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title><%= AUTHOR_NAME %></title>
  <link href="<%= SITE_URL %>/" />
  <link rel="self" href="<%= SITE_URL %>/Feeds/atom.xml" />
  <id><%= SITE_URL %>/</id>
  <updated><%= Time.now.strftime('%Y-%m-%dT%H:%M:%SZ') %></updated>
  <author>
    <name><%= AUTHOR_NAME %></name>
    <email><%= AUTHOR_EMAIL %></email>
  </author>
<%- posts.each do |post| -%>
  <entry>
    <title><%= h(post.title) %></title>
    <link href="<%= post.url %>" />
    <id><%= post.url %></id>
    <published><%= post.date_iso %>T00:00:00Z</published>
    <updated><%= post.date_iso %>T00:00:00Z</updated>
<%- if post.description -%>
    <summary><%= h(post.description) %></summary>
<%- end -%>
    <content type="html"><![CDATA[<%= post.content_html %>]]></content>
  </entry>
<%- end -%>
</feed>
