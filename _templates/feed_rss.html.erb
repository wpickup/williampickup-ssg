<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/">
<channel>
  <title><%= AUTHOR_NAME %>'s Blog</title>
  <link><%= SITE_URL %>/</link>
  <description><%= SITE_DESC %></description>
  <language>en-us</language>
  <copyright>Copyright <%= COPYRIGHT_YEAR %> <%= AUTHOR_NAME %></copyright>
  <managingEditor><%= AUTHOR_EMAIL %> (<%= AUTHOR_NAME %>)</managingEditor>
  <webMaster><%= AUTHOR_EMAIL %> (<%= AUTHOR_NAME %>)</webMaster>
  <lastBuildDate><%= Time.now.strftime('%a, %d %b %Y %H:%M:%S %z') %></lastBuildDate>
  <atom:link href="<%= SITE_URL %>/feeds/rss.xml" rel="self" type="application/rss+xml" />
<%- posts.each do |entry| -%>
  <item>
    <title><%= h(entry.title || 'Note') %></title>
    <link><%= entry.url %></link>
    <guid isPermaLink="true"><%= entry.url %></guid>
    <pubDate><%= entry.date&.strftime('%a, %d %b %Y 00:00:00 +0000') %></pubDate>
<%- if entry.respond_to?(:description) && entry.description -%>
    <description><![CDATA[<%= entry.description %>]]></description>
<%- end -%>
<%- if entry.respond_to?(:categories) -%>
<%- entry.categories.each do |cat| -%>
    <category><%= h(cat) %></category>
<%- end -%>
<%- entry.topics.each do |t| -%>
    <category domain="topic"><%= h(t) %></category>
<%- end -%>
<%- end -%>
    <content:encoded><![CDATA[<%= entry.content_html %>]]></content:encoded>
  </item>
<%- end -%>
</channel>
</rss>
