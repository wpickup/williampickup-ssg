<%# Prism syntax highlighting — rendered only on pages whose body contains a
    language-tagged code block (see has_code_blocks? in build.rb). The
    autoloader fetches each language's grammar from the same CDN path on
    demand, so no language list needs maintaining here. Colour overrides for
    the site's themes live in site.css under "SYNTAX HIGHLIGHTING". -%>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
