      <footer class="site-footer">
      <nav class="footer-nav" aria-label="Footer navigation">
<%- nav = defined?(current) ? current : nil
    fp  = renderer.nav_data['footer_primary']   || []
    fs  = renderer.nav_data['footer_secondary'] || [] -%>
        <div class="footer-nav__group">
<%- fp.each do |item| -%>
          <a href="<%= root %><%= item['href'] %>"<%= ' aria-current="page"' if nav && nav == item['current'] %>><%= item['label'] %></a>
<%- end -%>
        </div>
        <div class="footer-nav__group">
<%- fs.each do |item| -%>
<%- if item['email'] -%>
          <a href="<%= item['href'] %>"><%= item['label'] %></a>
<%- else -%>
          <a href="<%= root %><%= item['href'] %>"<%= ' aria-current="page"' if nav && nav == item['current'] %>><%= item['label'] %></a>
<%- end -%>
<%- end -%>
        </div>
      </nav>
      <p class="footer-copy">&copy; <%= COPYRIGHT_YEAR %> <%= AUTHOR_NAME %> &nbsp;&middot;&nbsp; <a class="footer-version" href="<%= root %>colophon.html">built <%= BUILD_STAMP %></a></p>
    </footer>
